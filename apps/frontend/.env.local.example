# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:10000

# Socket.io URL (same as API URL)
NEXT_PUBLIC_SOCKET_URL=http://localhost:10000

# No map API key is needed.
# Maps render from OpenStreetMap tiles via Leaflet, routing comes from OSRM, and
# locations are captured as coordinates encoded locally into Plus Codes. Nothing
# in the browser talks to Google Maps or any other paid geocoding service.

# Paystack Public Key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Push Notifications VAPID Key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

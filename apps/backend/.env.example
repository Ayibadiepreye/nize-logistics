# Server Configuration
NODE_ENV=development
PORT=10000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/nize_logistics

# JWT Secret (generate a random 64-character string)
JWT_SECRET=your-secret-key-here-change-this-in-production

# Paystack (Get from https://dashboard.paystack.com/)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Routing engine (optional)
# Unset uses the public OSRM demo server (https://router.project-osrm.org).
# Set this to a self-hosted instance when you need reliable routing at scale.
# OSRM_URL=https://osrm.example.com

# Addressing
# No key needed. Locations are captured as coordinates and encoded locally into
# Plus Codes, so nothing here talks to Google or any other paid geocoder.

# Cloudinary (Optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration
EMAIL_SERVICE=smtp
EMAIL_FROM=noreply@nizelogistics.com

# SMTP Settings (for Mailjet, Gmail, or generic SMTP)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Resend (Alternative to SMTP)
RESEND_API_KEY=your_resend_api_key

# Push Notifications (Optional)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
